@page "/region"
@using AlefahERP.DTO
@using AlefahERP.Services
@using System.Linq.Dynamic.Core
@inject IUnitOfWork unitofWork
@inject DialogService DialogService
@implements IDisposable
@attribute [Authorize(Roles = "Admin, Customer")]

<div class="container-fluid">

    <div class="row mb-5">
        <div class="col-lg-6">
            <RadzenText TextStyle="TextStyle.DisplayH4" TagName="TagName.H4" Text="Region" />
        </div>
        <div class="col-lg-6">
            <div class="d-block justify-content-end">
                <RadzenBreadCrumb Class="rz-text-align-end">
                    <Template Context="item">
                        <RadzenBadge Text="@item.Text" IsPill="true" />
                    </Template>
                    <ChildContent>
                        <RadzenBreadCrumbItem Text="Setup" />
                        <RadzenBreadCrumbItem Icon="add" Text="Region" />
                    </ChildContent>
                </RadzenBreadCrumb>
            </div>
        </div>
    </div>

    <RadzenCard Class="mb-3">
        <RadzenText TextStyle="TextStyle.DisplayH5" TagName="TagName.H5" Class="mb-5">Information</RadzenText>
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Visible=@showErrorMessage>
            @message
        </RadzenAlert>
        <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" Visible=@showSuccessMessage>
            @message
        </RadzenAlert>
        <RadzenTemplateForm TItem="Region" Data="@model" Submit="OnCreate">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <RadzenText>Region Code <span class="text-danger">*</span></RadzenText>
                        <div class="input-group">
                            <RadzenDropDown @bind-Value="@model.CountryID" TextProperty="CountryName" ValueProperty="CountryID" Data="@countries" class="w-100">

                            </RadzenDropDown>
                        </div>
                        <RadzenRequiredValidator Component="CountryID" Text="Country field is required." Popup=@popup Style="position:absolute" />                        
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <RadzenText>Region Code <span class="text-danger">*</span></RadzenText>
                        <div class="input-group">
                            <RadzenTextBox class="w-100" Name="RegionName" @bind-Value="@model.RegionName" />
                        </div>
                        <RadzenLengthValidator Component="RegionName" Min="3" Text="Region name should be at least 5 characters" Popup=@popup Style="position:absolute" />
                        <RadzenLengthValidator Component="RegionName" Max="50" Text="Region name should be at most 50 characters" Popup=@popup Style="position:absolute" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <RadzenText>Region Code <span class="text-danger">*</span></RadzenText>
                        <div class="input-group">
                            <RadzenTextBox class="w-100" Name="RegionCode" @bind-Value="@model.RegionCode" />
                        </div>
                        <RadzenLengthValidator Component="RegionCode" Min="3" Text="Region code should be at least 10 characters" Popup=@popup Style="position:absolute" />
                        <RadzenLengthValidator Component="RegionCode" Max="150" Text="Region code should be at most 150 characters" Popup=@popup Style="position:absolute" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="float-start d-block" style="margin-top:25px !important;">
                        <RadzenButton Text="Add" ButtonType="ButtonType.Submit" IsBusy="@IsBusy" Disabled=@IsBusy BusyText="Add..." />
                        <RadzenButton Text="Cancel" ButtonType="ButtonType.Reset" Disabled=@IsBusy ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" />
                    </div>
                </div>
            </div>
        </RadzenTemplateForm>
    </RadzenCard>

    <RadzenCard class="mb-3">
        <RadzenText TextStyle="TextStyle.DisplayH5" TagName="TagName.H5" Class="mb-5">Region Detail</RadzenText>
        <RadzenDataGrid @ref="grid" LoadData="@GridLoadData" Data="@Region" Count="@count" IsLoading="@IsDataGridLoading" TItem="Region" AllowFiltering="true" AllowColumnResize="true" AllowAlternatingRows="false" FilterMode="FilterMode.Advanced" AllowSorting="true" PageSize="5" AllowPaging="true" PagerHorizontalAlign="HorizontalAlign.Left" ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn TItem="Region" Property="CountryID" Title="Country ID">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Region" Property="RegionName" Title="Region Name" Frozen="true">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Region" Property="RegionCode" Title="Region Code" />               
                <RadzenDataGridColumn TItem="Region" Property="RegionID" Title="Action" Sortable="false" Filterable="false">
                    <Template Context="item">
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" Icon="edit" Class="me-1" Click=@(agrds => OnOpenDialog(item.RegionID)) />
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Icon="delete" Click=@(agrds => OnDelete(item.RegionID)) />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</div>




@code {

    bool checkBox1Value = true;
    Region model = new Region();
    List<Country> countries = new List<Country>();
    List<Region> Region = new List<Region>();
    RadzenDataGrid<Region>? grid;
    bool IsDataGridLoading = false;
    int count = 0;
    string? message;
    bool popup = true;
    bool IsBusy;
    bool showSuccessMessage;
    bool showErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        DialogService.OnOpen += Open;
        DialogService.OnClose += Close;

        await PreGridLoadData();
        GetCountryList();
    }
    public void Dispose()
    {
        DialogService.OnOpen -= Open;
        DialogService.OnClose -= Close;
    }

    void GetCountryList()
    {
        countries = this.unitofWork.Setup.Country.GetAll().ToList();

    }

    async Task GridLoadData(LoadDataArgs args)
    {

        await PreGridLoadData(args);
    }

    async Task PreGridLoadData(LoadDataArgs? args = null)
    {

        IsDataGridLoading = true;


        await Task.Yield();

        IQueryable<Region> query = this.unitofWork.Setup.Region.GetAll();

        if (args != null)
        {
            if (!string.IsNullOrEmpty(args.Filter))
            {

                query = query.Where(args.Filter);
            }

            if (!string.IsNullOrEmpty(args.OrderBy))
            {
                query = query.OrderBy(args.OrderBy);
            }
            else
            {
                query = query.OrderByDescending(o => o.RegionID);
            }
        }
        else
        {

            query = query.OrderByDescending(o => o.RegionID);
        }

        count = query.Count();

        if (args == null)
        {
            query = query.Skip(0).Take(5);
        }
        else
        {
            query = query.Skip(args.Skip.Value).Take(args.Top.Value);
        }

        Region = query.ToList();

        IsDataGridLoading = false;
    }

    async Task OnCreate()
    {
        try
        {
            await Task.Yield();

            IsBusy = true;
            if (model != null)
            {
                var results = await this.unitofWork.Setup.Region.Add(model);

                if (results != null)
                {
                    if (results.status)
                    {
                        showSuccessMessage = true;
                        showErrorMessage = false;

                        message = results.message;

                        model = new Region();

                        if (grid != null)
                            await grid.Reload();
                    }


                }
                else
                {
                    showSuccessMessage = false;
                    showErrorMessage = true;
                    message = "An error occured";
                }
            }
            else
            {
                showSuccessMessage = false;
                showErrorMessage = true;
                message = "An error occured";
            }
        }
        catch (Exception ex)
        {
            showSuccessMessage = false;
            showErrorMessage = true;
            message = ex.Message;
            throw ex;

        }
        finally
        {
            showSuccessMessage = false;
            showErrorMessage = false;
            IsBusy = false;
        }
    }


    async Task OnDelete(int RegionID)
    {
        try
        {

            var confirm = await DialogService.Confirm("Are you sure!, You want to delete this record.", "Confirm", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

            if (confirm.HasValue)
            {

                if (confirm.Value)
                {

                    var result = await this.unitofWork.Setup.Region.Delete(RegionID);
                    if (result != null)
                    {
                        if (result.status)
                        {
                            model = new Region();

                            if (grid != null)
                                await grid.Reload();
                        }
                    }

                }
            }


        }
        catch (Exception ex)
        {

            throw ex;
        }
        finally
        {

        }
    }


    async Task OnOpenDialog(int RegionID)
    {

        await DialogService.OpenSideAsync<RegionEditPage>($"Edit Region",
               new Dictionary<string, object>() { { "RegionID", RegionID } },
               new SideDialogOptions() { Position = DialogPosition.Right });


    }

    void Open(string title, Type type, Dictionary<string, object> parameters, DialogOptions options)
    {
        //console.Log("Dialog opened");
    }

    void Close(dynamic result)
    {

    }



}
