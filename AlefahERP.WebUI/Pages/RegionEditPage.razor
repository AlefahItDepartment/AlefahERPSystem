@page "/region/{RegionID}"
@using AlefahERP.DTO
@using AlefahERP.Services
@inject DialogService dialogService

@inject IUnitOfWork unitofWork

<div class="p-3">
    <div class="row mb-3">
        <div class="col-lg-12">
            <RadzenAlert Visible=@showSuccessMessage AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter">
                @message
            </RadzenAlert>
            <RadzenAlert Visible=@showErrorMessage AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
                @message
            </RadzenAlert>
        </div>
    </div>


    <RadzenTemplateForm TItem="Region" Data="@model" Submit="OnUpdate">
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group mb-1">
                    <RadzenText>Region Code <span class="text-danger">*</span></RadzenText>
                    <div class="input-group">
                        <RadzenDropDown @bind-Value="@model.CountryID" TextProperty="CountryName" ValueProperty="CountryID" Data="@countries" class="w-100">

                        </RadzenDropDown>
                    </div>
                    <RadzenRequiredValidator Component="CountryID" Text="Country field is required." Popup=@popup Style="position:absolute" />
                </div>
                <div class="form-group mb-1">
                    <RadzenText>Region Name</RadzenText>
                    <div class="input-group">
                        <RadzenTextBox Name="RegionName" @bind-Value=@model.RegionName class="w-100" />
                    </div>
                    <RadzenLengthValidator Component="RegionName" Min="3" Text="Region name should be at least 5 characters" Popup=@popup Style="position:absolute" />
                    <RadzenLengthValidator Component="RegionName" Max="50" Text="Region name should be at most 50 characters" Popup=@popup Style="position:absolute" />
                </div>
                <div class="form-group mb-1">
                    <RadzenText>Region Code</RadzenText>
                    <div class="input-group">
                        <RadzenTextBox Name="RegionCode" @bind-Value=@model.RegionCode class="w-100" />
                    </div>
                    <RadzenLengthValidator Component="RegionCode" Min="3" Text="Region code should be at least 10 characters" Popup=@popup Style="position:absolute" />
                    <RadzenLengthValidator Component="RegionCode" Max="150" Text="Region code should be at most 150 characters" Popup=@popup Style="position:absolute" />
                </div> 
                <div class="form-group mb-1">
                    <RadzenButton Text="Update" ButtonType="ButtonType.Submit" IsBusy="@IsBusy" Disabled="@IsBusy" BusyText="Update..." Click=@((args) => OnUpdate()) />
                    <RadzenButton Text="Cancel" ButtonType="ButtonType.Button" Disabled="@IsBusy" ButtonStyle="ButtonStyle.Light" Shade="Shade.Lighter" Click="@((args)=> dialogService.CloseSide(false))" />
                </div>
            </div>
        </div>
    </RadzenTemplateForm>
</div>


@code {
    bool popup=true;
    bool IsBusy;
    bool showSuccessMessage;
    bool showErrorMessage;
    string message;
    List<Country> countries = new List<Country>();

    [Parameter]
    public int RegionID { get; set; }

    Region model;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var results = await this.unitofWork.Setup.Region.Get(RegionID);
        if (results.status)
            model = results.data;

        GetCountryList();
    }
    void GetCountryList()
    {
        countries = this.unitofWork.Setup.Country.GetAll().ToList();

    }

    async Task OnUpdate()
    {
        IsBusy = true;

        try
        {
            await Task.Yield();

            model.RegionID = RegionID;

            var result = await this.unitofWork.Setup.Region.Update(model);

            if (result != null)
            {
                if (result.status)
                {
                    message = result.message;
                    showSuccessMessage = true;
                    showErrorMessage = false;

                    Task.Delay(500);
                    dialogService.CloseSide(model);
                }
                else
                {
                    message = "An error occured.";
                    showSuccessMessage = false;
                    showErrorMessage = true;
                }
            }
            else
            {
                message = "An error occured.";
                showSuccessMessage = false;
                showErrorMessage = true;
            }

        }
        catch (Exception ex)
        {
            message = ex.Message;
            showSuccessMessage = false;
            showErrorMessage = true;
            throw ex;
        }
        finally
        {

            IsBusy = false;
            showSuccessMessage = false;
            showErrorMessage = false;
        }
    }

}
